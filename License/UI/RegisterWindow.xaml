<Window x:Class="TranslationEplAddIn.Tool.License.UI.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="EPLAN 插件授权激活" Height="400" Width="550"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
    <Window.Resources>
        <!-- Custom Scrollbar/Styles if needed, but keeping it clean -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="#00ADB5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="true">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#00C4CC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#00959C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="border" Property="Background" Value="#4A5568"/>
                                <Setter Property="Foreground" Value="#A0AEC0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="#2D2D37"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="#3D3D4E" BorderThickness="1" SnapsToDevicePixels="true">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#3D3D4E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#1E1E24"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1E1E24" CornerRadius="12" BorderBrush="#34343F" BorderThickness="1.5">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Error / Status Bar -->
                <RowDefinition Height="Auto"/> <!-- Machine Code Block -->
                <RowDefinition Height="*"/>    <!-- License Import Area -->
                <RowDefinition Height="Auto"/> <!-- Actions -->
            </Grid.RowDefinitions>

            <!-- 1. Title bar -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M18,8H17V6A5,5,0,0,0,7,6V8H6A2,2,0,0,0,4,10V20A2,2,0,0,0,6,22H18A2,2,0,0,0,20,20V10A2,2,0,0,0,18,8ZM9,6a3,3,0,0,1,6,0V8H9ZM12,17a1.5,1.5,0,1,1,1.5-1.5A1.5,1.5,0,0,1,12,17Z" 
                          Fill="#00ADB5" Width="18" Height="18" Stretch="Fill" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="EPLAN 插件授权激活" Foreground="#EEEEEE" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="✕" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Center" 
                        Background="Transparent" BorderThickness="0" Foreground="#9E9EA7" FontSize="14" Cursor="Hand" Click="Close_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="#FF2E63"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 2. Error / Status Message -->
            <Border Grid.Row="1" x:Name="ErrorBorder" Background="#2A1B24" BorderBrush="#FF2E63" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,15" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10,10-4.48,10-10S17.52,2,12,2Zm1,15h-2v-2h2v2Zm0-4h-2V7h2v6Z" 
                          Fill="#FF2E63" Width="16" Height="16" Stretch="Fill" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" x:Name="TxtError" Text="未检测到有效授权" Foreground="#FF8A9A" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 3. Machine Code Block -->
            <StackPanel Grid.Row="2" Margin="0,0,0,15">
                <TextBlock Text="本机机器码：" Foreground="#9E9EA7" FontSize="12.5" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtMachineCode" Grid.Column="0" Background="#121216" Foreground="#EEEEEE" BorderBrush="#34343F" BorderThickness="1" 
                             Padding="10,8" FontSize="14" FontFamily="Consolas" IsReadOnly="True" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="复制" Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0" Padding="15,6" VerticalAlignment="Stretch" Click="CopyMachineCode_Click"/>
                </Grid>
            </StackPanel>

            <!-- 4. License Import Area (Drag & Drop) -->
            <Border Grid.Row="3" x:Name="DropBorder" Background="#121216" BorderBrush="#34343F" BorderThickness="1.5" CornerRadius="8" 
                    AllowDrop="True" DragEnter="DropBorder_DragEnter" DragLeave="DropBorder_DragLeave" Drop="DropBorder_Drop" MouseLeftButtonDown="DropBorder_MouseLeftButtonDown" Margin="0,0,0,20">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#00ADB5"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Icon -->
                        <Path Data="M19.35,10.04C18.67,6.59,15.64,4,12,4C9.11,4,6.6,5.64,5.35,8.04C2.34,8.36,0,10.91,0,14C0,17.31,2.69,20,6,20H19C21.76,20,24,17.76,24,15C24,12.36,21.95,10.22,19.35,10.04ZM19,18H6C3.79,18,2,16.21,2,14C2,11.95,3.53,10.24,5.56,10.03L6.63,9.92L7.13,8.97C8.08,7.14,9.94,6,12,6C14.62,6,16.88,7.86,17.39,10.43L17.69,11.93L19.22,12.04C20.78,12.14,22,13.45,22,15C22,16.65,20.65,18,19,18ZM12,9L8,13H11V16H13V13H16L12,9Z" 
                              Fill="#4A5568" Width="40" Height="40" Stretch="Fill" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="拖拽 license.lic 授权文件到此处，或点击浏览上传" Foreground="#9E9EA7" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock x:Name="TxtSelectedFile" Text="未选择任何 file" Foreground="#00ADB5" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 5. Actions -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="状态: 未激活" Foreground="#9E9EA7" VerticalAlignment="Center" FontSize="13"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="取消退出" Style="{StaticResource SecondaryBtn}" Width="100" Margin="0,0,10,0" Click="Cancel_Click"/>
                    <Button x:Name="BtnActivate" Content="立即激活" Style="{StaticResource ModernBtn}" Width="120" Click="Activate_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
