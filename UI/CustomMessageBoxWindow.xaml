<Window x:Class="TranslationEplAddIn.Tool.UI.CustomMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示" 
        Width="460" 
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        FontFamily="Microsoft YaHei, Segoe UI"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Standard Button Style matching project theme -->
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E5E4DB"/>
            <Setter Property="Foreground" Value="#3D3D3A"/>
            <Setter Property="BorderBrush" Value="#DDDBCF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24,6"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#CD7F62"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#CD7F62"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#B26950"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#B26950"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Button in Title Bar -->
        <Style x:Key="TitleCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="0,6,0,0">
                            <Path Data="M 10 10 L 22 22 M 10 22 L 22 10" 
                                  Stroke="#727068" 
                                  StrokeThickness="1.5" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E81123"/>
                                <Setter TargetName="Bg" Property="TextElement.Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.RenderTransform>
        <TransformGroup>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
            <TranslateTransform X="0" Y="0"/>
        </TransformGroup>
    </Window.RenderTransform>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" 
                                     From="15" To="0" Duration="0:0:0.18" DecelerationRatio="0.8"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <!-- Custom Dialog Shadow and Border Layout -->
    <Border Background="#F5F2EA" BorderBrush="#DDDBCF" BorderThickness="1" CornerRadius="8" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.15"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar (Draggable) -->
            <Border Grid.Row="0" x:Name="TitleBar" Background="#E2DDD3" CornerRadius="7,7,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock x:Name="TxtTitle" Text="提示" 
                               Foreground="#626058" 
                               FontWeight="Bold" 
                               FontSize="12.5" 
                               VerticalAlignment="Center" 
                               Margin="16,0,40,0"
                               TextTrimming="CharacterEllipsis"/>
                    
                    <Button x:Name="BtnClose" Style="{StaticResource TitleCloseButtonStyle}" 
                            HorizontalAlignment="Right" VerticalAlignment="Top" 
                            Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- Message Body Area -->
            <Grid Grid.Row="1" Margin="24,20,24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Icon Container -->
                <Grid Grid.Column="0" VerticalAlignment="Top" Margin="0,2,16,0">
                    <!-- Information Icon -->
                    <Grid x:Name="IconInfo" Visibility="Collapsed" Width="36" Height="36">
                        <Ellipse Fill="#E6F2FF" Stroke="#4A90E2" StrokeThickness="1.5"/>
                        <Path Data="M 18 10 L 18 12 M 18 15 L 18 26" Stroke="#4A90E2" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid>

                    <!-- Warning Icon -->
                    <Grid x:Name="IconWarning" Visibility="Collapsed" Width="36" Height="36">
                        <Path Data="M 18 4 L 32 30 C 33 32, 31.5 32, 30 32 L 6 32 C 4.5 32, 3 32, 4 30 Z" Fill="#FEF3C7" Stroke="#D97706" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                        <Path Data="M 18 13 L 18 21 M 18 25 L 18 27" Stroke="#D97706" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid>

                    <!-- Error Icon -->
                    <Grid x:Name="IconError" Visibility="Collapsed" Width="36" Height="36">
                        <Ellipse Fill="#FEE2E2" Stroke="#D32F2F" StrokeThickness="1.5"/>
                        <Path Data="M 12 12 L 24 24 M 12 24 L 24 12" Stroke="#D32F2F" StrokeThickness="2.5" StrokeStartLineCap="Round"/>
                    </Grid>

                    <!-- Question Icon -->
                    <Grid x:Name="IconQuestion" Visibility="Collapsed" Width="36" Height="36">
                        <Ellipse Fill="#ECFDF5" Stroke="#10B981" StrokeThickness="1.5"/>
                        <Path Data="M 14 15 C 14 11, 22 11, 22 15 C 22 18, 18 19, 18 21 L 18 23 M 18 27 L 18 28" Stroke="#10B981" StrokeThickness="2.5" StrokeStartLineCap="Round"/>
                    </Grid>
                </Grid>

                <!-- Message Content -->
                <ScrollViewer Grid.Column="1" MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="TxtMessage" Text="" 
                               Foreground="#3D3D3A" 
                               FontSize="13" 
                               TextWrapping="Wrap" 
                               LineHeight="18"
                               VerticalAlignment="Center"/>
                </ScrollViewer>
            </Grid>

            <!-- Bottom Button Bar Area -->
            <Border Grid.Row="2" Background="#E2DDD3" CornerRadius="0,0,7,7" BorderBrush="#DDDBCF" BorderThickness="0,1,0,0" Padding="16,10">
                <StackPanel x:Name="BtnPanel" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnYes" Content="是 (Yes)" Style="{StaticResource DialogButtonStyle}" Visibility="Collapsed" Click="BtnYes_Click"/>
                    <Button x:Name="BtnNo" Content="否 (No)" Style="{StaticResource DialogButtonStyle}" Visibility="Collapsed" Click="BtnNo_Click"/>
                    <Button x:Name="BtnOk" Content="确定" Style="{StaticResource DialogButtonStyle}" Visibility="Collapsed" Click="BtnOk_Click"/>
                    <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource DialogButtonStyle}" Visibility="Collapsed" Click="BtnCancel_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
