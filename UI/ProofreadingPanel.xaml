<UserControl x:Class="TranslationEplAddIn.Tool.UI.ProofreadingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="800">
    
    <UserControl.Resources>
        <!-- Modern Rounded Button Style -->
        <Style x:Key="PanelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#494944"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5C5C57"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#353532"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#EBE9DF"/>
                                <Setter Property="Foreground" Value="#A8A69F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#3D3D3A"/>
            <Setter Property="BorderBrush" Value="#DDDBCF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#3D3D3A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                SnapsToDevicePixels="True" 
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#CD7F62"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#B5B3A7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title / Workbench Header -->
            <RowDefinition Height="Auto"/> <!-- Find & Replace Toolbars -->
            <RowDefinition Height="*"/>    <!-- Data Grid -->
            <RowDefinition Height="Auto"/> <!-- Summary Status Bar -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="#EBE9DF" BorderThickness="0,0,0,1" Padding="12,10">
            <DockPanel>
                <TextBlock Text="图纸翻译校对准交互工作板" Foreground="#3D3D3A" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Find & Replace Toolbar -->
        <Border Grid.Row="1" Background="#FAF9F6" BorderBrush="#EBE9DF" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="查找内容:" Foreground="#3D3D3A" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                    <TextBox Name="FindTextBox" Width="130" Height="28" Margin="0,0,15,0"/>
                    
                    <TextBlock Text="替换为:" Foreground="#3D3D3A" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                    <TextBox Name="ReplaceTextBox" Width="130" Height="28" Margin="0,0,15,0"/>
                    
                    <Button Name="FindBtn" Content="查找" Style="{StaticResource PanelButtonStyle}" Height="28" Click="FindBtn_Click" Margin="0,0,8,0"/>
                    <Button Name="ReplaceBtn" Content="替换" Style="{StaticResource PanelButtonStyle}" Height="28" Click="ReplaceBtn_Click" Margin="0,0,8,0"/>
                    <Button Name="ReplaceAllBtn" Content="全部替换" Style="{StaticResource PanelButtonStyle}" Height="28" Click="ReplaceAllBtn_Click"/>
                    <Button Name="RetranslateSelectedBtn" Content="重新翻译选中" Style="{StaticResource PanelButtonStyle}" Height="28" Click="RetranslateSelectedBtn_Click" Margin="15,0,0,0" Background="#4A75A3"/>
                    <Button Name="DeleteSelectedBtn" Content="删除选中" Style="{StaticResource PanelButtonStyle}" Height="28" Click="DeleteSelectedBtn_Click" Margin="8,0,0,0" Background="#A12626"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Data Grid -->
        <DataGrid Name="TranslationDataGrid" Grid.Row="2" AutoGenerateColumns="False" 
                  Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#FAF9F6" 
                  Foreground="#3D3D3A" BorderThickness="0" GridLinesVisibility="Horizontal" 
                  HorizontalGridLinesBrush="#EBE9DF" HeadersVisibility="Column" 
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  CellEditEnding="TranslationDataGrid_CellEditEnding"
                  PreviewKeyDown="TranslationDataGrid_PreviewKeyDown">
            
            <DataGrid.Resources>
                <!-- Column Header Style -->
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F5F4EF"/>
                    <Setter Property="Foreground" Value="#3D3D3A"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="BorderBrush" Value="#EBE9DF"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
                
                <!-- Cell Style with Padding and selection brush -->
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}" 
                                        Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#E5E4DB"/>
                            <Setter Property="Foreground" Value="#3D3D3A"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="图纸页号" Binding="{Binding PageName}" Width="150" IsReadOnly="True"/>
                
                <!-- Schema Type Column -->
                <DataGridTemplateColumn Header="对象类型" SortMemberPath="ElementType" Width="130" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ElementType}" Foreground="#9E5E38" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="原文内容" Binding="{Binding SourceText}" Width="220" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                
                <DataGridTextColumn Header="译文内容" Binding="{Binding TranslatedText}" Width="*" IsReadOnly="False">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="AcceptsReturn" Value="True"/>
                            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
                
                <!-- Status Badges -->
                <DataGridTemplateColumn Header="当前状态" Width="105" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="BadgeBorder" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" BorderThickness="1" Background="#F1F0EC" BorderBrush="#727068">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Icon -->
                                    <Path x:Name="BadgeIcon" Width="10" Height="10" Fill="#727068" Margin="0,0,4,0" Stretch="Uniform" Data="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm1 10h-3V7h2v3h1v2z"/>
                                    <!-- Text -->
                                    <TextBlock x:Name="BadgeText" Text="PENDING" FontSize="10" FontWeight="Bold" Foreground="#727068" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Translated">
                                    <Setter TargetName="BadgeBorder" Property="Background" Value="#ECF8EE"/>
                                    <Setter TargetName="BadgeBorder" Property="BorderBrush" Value="#317042"/>
                                    <Setter TargetName="BadgeText" Property="Foreground" Value="#317042"/>
                                    <Setter TargetName="BadgeText" Property="Text" Value="Success"/>
                                    <Setter TargetName="BadgeIcon" Property="Fill" Value="#317042"/>
                                    <Setter TargetName="BadgeIcon" Property="Data" Value="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Success">
                                    <Setter TargetName="BadgeBorder" Property="Background" Value="#ECF8EE"/>
                                    <Setter TargetName="BadgeBorder" Property="BorderBrush" Value="#317042"/>
                                    <Setter TargetName="BadgeText" Property="Foreground" Value="#317042"/>
                                    <Setter TargetName="BadgeText" Property="Text" Value="Success"/>
                                    <Setter TargetName="BadgeIcon" Property="Fill" Value="#317042"/>
                                    <Setter TargetName="BadgeIcon" Property="Data" Value="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Glossary">
                                    <Setter TargetName="BadgeBorder" Property="Background" Value="#F3E8FF"/>
                                    <Setter TargetName="BadgeBorder" Property="BorderBrush" Value="#6B21A8"/>
                                    <Setter TargetName="BadgeText" Property="Foreground" Value="#6B21A8"/>
                                    <Setter TargetName="BadgeText" Property="Text" Value="Glossary"/>
                                    <Setter TargetName="BadgeIcon" Property="Fill" Value="#6B21A8"/>
                                    <Setter TargetName="BadgeIcon" Property="Data" Value="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Error">
                                    <Setter TargetName="BadgeBorder" Property="Background" Value="#FCECEF"/>
                                    <Setter TargetName="BadgeBorder" Property="BorderBrush" Value="#A12626"/>
                                    <Setter TargetName="BadgeText" Property="Foreground" Value="#A12626"/>
                                    <Setter TargetName="BadgeText" Property="Text" Value="Error"/>
                                    <Setter TargetName="BadgeIcon" Property="Fill" Value="#A12626"/>
                                    <Setter TargetName="BadgeIcon" Property="Data" Value="M12 2C6.47 2 2 6.47 2 12s4.47 10 9.99 10S22 17.52 22 12 17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="翻译引擎" Binding="{Binding EngineUsed}" Width="100" IsReadOnly="True"/>
                
                <!-- Locate Button -->
                <DataGridTemplateColumn Header="图纸校验定位" Width="100" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Click="LocateBtn_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" Padding="4" Cursor="Hand" ToolTip="在图纸中定位">
                                <Path Width="14" Height="14" Fill="#727068" Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" Stretch="Uniform"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Summary Footer -->
        <Border Grid.Row="3" Background="#F5F4EF" BorderBrush="#EBE9DF" BorderThickness="0,1,0,0" Padding="12,10">
            <DockPanel>
                <TextBlock Name="SummaryTextBlock" Text="未检测到翻译数据" Foreground="#7C7A74" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
