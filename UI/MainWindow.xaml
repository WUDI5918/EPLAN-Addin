<Window x:Class="TranslationEplAddIn.Tool.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:TranslationEplAddIn.Tool.UI"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="EPLAN 智能多语言翻译助手" Height="780" Width="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F0ECE1" Foreground="#3D3D3A"
        FontFamily="Microsoft YaHei, Segoe UI">

    <Window.Resources>
        <!-- TabControl Style to hide headers -->
        <Style TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <ContentPresenter Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Navigation Tab Button Style -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E5E4DB"/>
            <Setter Property="Foreground" Value="#626058"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BgBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#CD7F62"/>
                                <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#3D3D3A"/>
            <Setter Property="BorderBrush" Value="#DDDBCF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#3D3D3A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="Border" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    Background="{TemplateBinding Background}" 
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True" 
                                    Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                            </Border>
                            <TextBlock x:Name="WatermarkPrompt" 
                                       Text="{TemplateBinding Tag}" 
                                       Foreground="#A8A69F" 
                                       FontSize="11" 
                                       Margin="12,0" 
                                       IsHitTestVisible="False" 
                                       VerticalAlignment="Center" 
                                       Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="WatermarkPrompt" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#CD7F62"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#B5B3A7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PasswordBox / Masked Style -->
        <Style x:Key="MaskedTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="Consolas, Courier New"/>
        </Style>

        <!-- ComboBox ToggleButton -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="4" Background="#FFFFFF" BorderBrush="#DDDBCF" BorderThickness="1" />
                <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#727068" Data="M 0 0 L 3.5 4 L 7 0 Z"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#B5B3A7"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#CD7F62"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="true"/>
            <Setter Property="Foreground" Value="#3D3D3A"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" 
                                          Template="{StaticResource ComboBoxToggleButton}" 
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,3,24,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <TextBox x:Name="PART_EditableTextBox"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Center"
                                     Margin="8,3,24,3"
                                     Focusable="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{TemplateBinding Foreground}"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"
                                     Visibility="Hidden">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border x:Name="PART_ContentHost" Focusable="False" Background="Transparent" />
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" 
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#FFFFFF"
                                            BorderThickness="1"
                                            BorderBrush="#DDDBCF"
                                            CornerRadius="4"
                                            Margin="0,2,0,0">
                                        <ScrollViewer Margin="2,4,2,4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter Property="IsTabStop" Value="false"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#3D3D3A"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="true"
                                CornerRadius="2"
                                Margin="2,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter Property="Background" Value="#E5E4DB"/>
                                <Setter Property="Foreground" Value="#3D3D3A"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" Value="#FAF9F6"/>
                                <Setter Property="Foreground" Value="#CD7F62"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#494944"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#5C5C57"/>
                                <Setter TargetName="Border" Property="TextElement.Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#353532"/>
                                <Setter TargetName="Border" Property="TextElement.Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#EBE9DF"/>
                                <Setter Property="Foreground" Value="#727068"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Reset Button Style -->
        <Style x:Key="ResetButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#A12626"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FCECEF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FCECEF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#3D3D3A"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="16" Height="16">
                                <Border x:Name="Box" Background="#FFFFFF" BorderBrush="#DDDBCF" BorderThickness="1" CornerRadius="3" />
                                <Path x:Name="Check" Width="10" Height="8" Fill="#CD7F62" Data="M9.293 0.707a1 1 0 0 1 0 1.414l-5 5a1 1 0 0 1-1.414 0l-2-2a1 1 0 1 1 1.414-1.414L3.5 4.793l4.293-4.293a1 1 0 0 1 1.414 0z" Stretch="Uniform" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#CD7F62"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#B5B3A7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBox Styling -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#3D3D3A"/>
            <Setter Property="BorderBrush" Value="#EBE9DF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <!-- Card Container Border Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#EBE9DF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Custom Header Bar -->
            <RowDefinition Height="*"/>    <!-- Tab Contents -->
            <RowDefinition Height="Auto"/> <!-- Progress Footer -->
        </Grid.RowDefinitions>

        <!-- Top Header & Menu bar -->
        <Border Grid.Row="0" Background="Transparent" BorderBrush="#EBE9DF" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <!-- Title Block with Badge & Subtitle -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <!-- App Logo Icon -->
                    <Border Background="#3D3D3A" CornerRadius="6" Width="30" Height="30" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Path Width="14" Height="14" Fill="#FFFFFF" Data="M12.87 15.07l-2.54-2.51.03-.03c1.74-1.94 2.98-4.17 3.71-6.53H17V4h-7V2H8v2H1v1.99h11.17C11.5 7.92 10.44 9.75 9 11.35 8.07 10.32 7.3 9.19 6.69 8h-2c.73 1.63 1.73 3.17 2.98 4.56l-5.09 5.02L4 19l5-5 3.11 3.11.76-2.04zM18.5 10h-2L12 22h2l1.12-3h4.75L21 22h2l-4.5-12zm-2.62 7l1.62-4.33L19.12 17h-3.24z" Stretch="Uniform"/>
                    </Border>
                    
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="EPLAN 智能翻译云助手" FontSize="16" FontWeight="Bold" Foreground="#3D3D3A" VerticalAlignment="Center"/>
                        <Border Background="#CD7F62" CornerRadius="8" Padding="5,2" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="AI PRO" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                        <TextBlock Name="ProjectNameLabel" Text="当前项目: 未检测到" FontSize="11" Foreground="#9E5E38" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Tabs (Top-Right) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" DockPanel.Dock="Right">
                    <Button Name="NavProjBtn" Content="翻译项目" Style="{StaticResource NavButtonStyle}" Click="NavBtn_Click"/>
                    <Button Name="NavSetBtn" Content="翻译设置" Style="{StaticResource NavButtonStyle}" Click="NavBtn_Click"/>
                    <Button Name="NavLogBtn" Content="日志与导出汇总" Style="{StaticResource NavButtonStyle}" Click="NavBtn_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Workspace via TabControl (Headers hidden by style) -->
        <TabControl Name="MainTabControl" Grid.Row="1" Margin="16" SelectionChanged="MainTabControl_SelectionChanged">
            
            <!-- ==================== TAB 0: 翻译项目 (Workbench) ==================== -->
            <TabItem Header="翻译项目">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Workbench Toolbars (Scope, Step commands) -->
                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Dropdowns (Scope, Source/Target languages) -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="翻译范围" FontSize="10" Foreground="#7C7A74" Margin="0,0,0,4"/>
                                    <ComboBox Name="ScopeComboBox" Width="100" Height="26">
                                        <ComboBoxItem Content="整个项目" IsSelected="True"/>
                                        <ComboBoxItem Content="选定页面"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="源语言" FontSize="10" Foreground="#7C7A74" Margin="0,0,0,4"/>
                                    <ComboBox Name="SourceLangComboBox" Width="165" Height="26">
                                        <ComboBoxItem Content="zh_CN ( Chinese )" IsSelected="True"/>
                                        <ComboBoxItem Content="cs_CZ ( Czech )"/>
                                        <ComboBoxItem Content="da_DK ( Danish )"/>
                                        <ComboBoxItem Content="de_DE ( German (Germany) )"/>
                                        <ComboBoxItem Content="en_US ( English (USA) )"/>
                                        <ComboBoxItem Content="es_ES ( Spanish (Spain) )"/>
                                        <ComboBoxItem Content="fr_FR ( French (France) )"/>
                                        <ComboBoxItem Content="hu_HU ( Hungarian )"/>
                                        <ComboBoxItem Content="it_IT ( Italian (Italy) )"/>
                                        <ComboBoxItem Content="ja_JP ( Japanese )"/>
                                        <ComboBoxItem Content="ko_KR ( Korean )"/>
                                        <ComboBoxItem Content="nl_NL ( Dutch (Netherlands) )"/>
                                        <ComboBoxItem Content="pl_PL ( Polish )"/>
                                        <ComboBoxItem Content="pt_BR ( Portuguese (Brazil) )"/>
                                        <ComboBoxItem Content="pt_PT ( Portuguese (Portugal) )"/>
                                        <ComboBoxItem Content="ro_RO ( Romanian )"/>
                                        <ComboBoxItem Content="ru_RU ( Russian )"/>
                                        <ComboBoxItem Content="sv_SE ( Swedish )"/>
                                        <ComboBoxItem Content="tr_TR ( Turkish )"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="目标语言" FontSize="10" Foreground="#7C7A74" Margin="0,0,0,4"/>
                                    <ComboBox Name="TargetLangComboBox" Width="165" Height="26">
                                        <ComboBoxItem Content="en_US ( English (USA) )" IsSelected="True"/>
                                        <ComboBoxItem Content="zh_CN ( Chinese )"/>
                                        <ComboBoxItem Content="cs_CZ ( Czech )"/>
                                        <ComboBoxItem Content="da_DK ( Danish )"/>
                                        <ComboBoxItem Content="de_DE ( German (Germany) )"/>
                                        <ComboBoxItem Content="es_ES ( Spanish (Spain) )"/>
                                        <ComboBoxItem Content="fr_FR ( French (France) )"/>
                                        <ComboBoxItem Content="hu_HU ( Hungarian )"/>
                                        <ComboBoxItem Content="it_IT ( Italian (Italy) )"/>
                                        <ComboBoxItem Content="ja_JP ( Japanese )"/>
                                        <ComboBoxItem Content="ko_KR ( Korean )"/>
                                        <ComboBoxItem Content="nl_NL ( Dutch (Netherlands) )"/>
                                        <ComboBoxItem Content="pl_PL ( Polish )"/>
                                        <ComboBoxItem Content="pt_BR ( Portuguese (Brazil) )"/>
                                        <ComboBoxItem Content="pt_PT ( Portuguese (Portugal) )"/>
                                        <ComboBoxItem Content="ro_RO ( Romanian )"/>
                                        <ComboBoxItem Content="ru_RU ( Russian )"/>
                                        <ComboBoxItem Content="sv_SE ( Swedish )"/>
                                        <ComboBoxItem Content="tr_TR ( Turkish )"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>

                            <!-- Workflow step buttons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                                <!-- Step 1 (White/border) -->
                                <Button Name="ExtractBtn" Content="1. 提取原文数据" Height="28" Padding="12,4" Click="ExtractBtn_Click" Background="#FFFFFF" Foreground="#3D3D3A" BorderThickness="1" BorderBrush="#DDDBCF" Margin="0,0,8,0"/>
                                <!-- Step 2 (Highlighted warm terracotta) -->
                                <Button Name="TranslateBtn" Content="2. 智能 AI 翻译" Height="28" Padding="12,4" Click="TranslateBtn_Click" IsEnabled="False" Margin="0,0,8,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="#CD7F62"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#D98F74"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- Step 3 (Dark grey) -->
                                <Button Name="WriteBackBtn" Content="3. 统一写入图纸" Height="28" Padding="12,4" Click="WriteBackBtn_Click" IsEnabled="False" Margin="0,0,8,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="#232323"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#3D3D3A"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                
                                <!-- Utility buttons -->
                                <Button Name="UndoBtn" Content="一键重置" Height="26" Padding="10,3" Click="UndoBtn_Click" Style="{StaticResource ResetButtonStyle}"/>
                            </StackPanel>

                            <!-- Quick status labels -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Name="CountLabel" Text="提取条目: 0" FontSize="11" Foreground="#CD7F62" FontWeight="Bold"/>
                                <TextBlock Name="EngineLabel" Text="当前引擎: Deepseek" FontSize="10" Foreground="#7C7A74" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Proofreading grid card -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#EBE9DF" BorderThickness="1" CornerRadius="8" Padding="2" VerticalAlignment="Stretch">
                        <ui:ProofreadingPanel x:Name="ProofreadingGrid"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ==================== TAB 1: 翻译设置 (Settings Center) ==================== -->
            <TabItem Header="翻译设置">
                <Grid>
                    <!-- Left Column: Engine Settings & Logic Options (Full Width) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0" Padding="0,0,6,0">
                        <StackPanel>
                            <!-- Card 1: Engine selection and URL config -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="智能翻译引擎与通道对准" FontWeight="Bold" FontSize="13" Foreground="#3D3D3A" VerticalAlignment="Center"/>
                                        <Border Background="#E1F3F8" CornerRadius="8" Padding="6,2" HorizontalAlignment="Right">
                                            <TextBlock Text="双通道多模态对齐" FontSize="9" FontWeight="Bold" Foreground="#0EA5E9"/>
                                        </Border>
                                    </Grid>

                                    <!-- Selector -->
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="选择辅助引擎" FontSize="11" Foreground="#7C7A74" Margin="0,0,0,4"/>
                                        <ComboBox Name="EngineComboBox" SelectionChanged="EngineComboBox_SelectionChanged" Height="28">
                                            <ComboBoxItem Content="Deepseek" IsSelected="True"/>
                                            <ComboBoxItem Content="Zhipu"/>
                                            <ComboBoxItem Content="DeepL"/>
                                            <ComboBoxItem Content="Google"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Deepseek Card -->
                                    <StackPanel Name="DeepseekConfigCard">
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="底层对齐模型 (Model):" VerticalAlignment="Center" FontSize="11"/>
                                            <ComboBox Name="DeepseekModelBox" Grid.Column="1" Height="30" IsEditable="True">
                                                <sys:String>deepseek-v4-flash</sys:String>
                                                <sys:String>deepseek-chat</sys:String>
                                                <sys:String>deepseek-reasoner</sys:String>
                                            </ComboBox>
                                        </Grid>
                                        
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Text="API Key:" VerticalAlignment="Center" FontSize="11"/>
                                                <TextBlock Text="本地密钥受端点高信任保护" FontSize="9" Foreground="#D97706" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBox Name="DeepseekKeyBox" Grid.Column="1" Height="30" Style="{StaticResource MaskedTextBoxStyle}"/>
                                        </Grid>

                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Base URL:" VerticalAlignment="Center" FontSize="11"/>
                                            <TextBox Name="DeepseekUrlBox" Grid.Column="1" Height="30"/>
                                        </Grid>
                                        
                                        <Button Name="TestDeepseekBtn" Content="测试引擎连接" Click="TestConnection_Click" HorizontalAlignment="Right" Margin="0,10,0,0" Height="26" Padding="12,2"/>
                                    </StackPanel>

                                    <!-- Zhipu Card -->
                                    <StackPanel Name="ZhipuConfigCard" Visibility="Collapsed">
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="底层对齐模型 (Model):" VerticalAlignment="Center" FontSize="11"/>
                                            <TextBox Name="ZhipuModelBox" Grid.Column="1" Height="30"/>
                                        </Grid>
                                        
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="API Key:" VerticalAlignment="Center" FontSize="11"/>
                                            <TextBox Name="ZhipuKeyBox" Grid.Column="1" Height="30" Style="{StaticResource MaskedTextBoxStyle}"/>
                                        </Grid>

                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Base URL:" VerticalAlignment="Center" FontSize="11"/>
                                            <TextBox Name="ZhipuUrlBox" Grid.Column="1" Height="30"/>
                                        </Grid>
                                        
                                        <Button Name="TestZhipuBtn" Content="测试引擎连接" Click="TestConnection_Click" HorizontalAlignment="Right" Margin="0,10,0,0" Height="26" Padding="12,2"/>
                                    </StackPanel>

                                    <!-- DeepL Card -->
                                    <StackPanel Name="DeeplConfigCard" Visibility="Collapsed">
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="API Key:" VerticalAlignment="Center" FontSize="11"/>
                                            <TextBox Name="DeeplKeyBox" Grid.Column="1" Height="30" Style="{StaticResource MaskedTextBoxStyle}"/>
                                        </Grid>
                                        
                                        <Button Name="TestDeeplBtn" Content="测试引擎连接" Click="TestConnection_Click" HorizontalAlignment="Right" Margin="0,10,0,0" Height="26" Padding="12,2"/>
                                    </StackPanel>

                                    <!-- Google Card -->
                                    <StackPanel Name="GoogleConfigCard" Visibility="Collapsed">
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="API Key:" VerticalAlignment="Center" FontSize="11"/>
                                            <TextBox Name="GoogleKeyBox" Grid.Column="1" Height="30" Style="{StaticResource MaskedTextBoxStyle}"/>
                                        </Grid>
                                        
                                        <Button Name="TestGoogleBtn" Content="测试引擎连接" Click="TestConnection_Click" HorizontalAlignment="Right" Margin="0,10,0,0" Height="26" Padding="12,2"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Translation Strategy Settings -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="翻译策略设置" FontWeight="Bold" FontSize="13" Foreground="#3D3D3A" Margin="0,0,0,12"/>
                                    
                                    <CheckBox Name="NativeDictCheckBox" IsChecked="False" Margin="0,4,0,8">
                                        <StackPanel>
                                            <TextBlock Text="启用 EPLAN 本地/系统原生翻译字典双向同步" FontWeight="SemiBold" FontSize="11" Foreground="#3D3D3A"/>
                                            <TextBlock Text="提取原文或翻译时，优先检索 EPLAN 标准字典库（.elk/.db）中的匹配条目直接采用；写入图纸时，可选同步写回到原生词典库。" FontSize="10" Foreground="#7C7A74" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Regex protection rules & sandboxing -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="正则表达式隔离防护栏" FontWeight="Bold" FontSize="13" Foreground="#3D3D3A" VerticalAlignment="Center"/>
                                        <Border Background="#FCECEF" CornerRadius="8" Padding="6,2" HorizontalAlignment="Right">
                                            <TextBlock Name="ActiveRulesCountLabel" Text="4 条激活" FontSize="9" FontWeight="Bold" Foreground="#A12626"/>
                                        </Border>
                                    </Grid>

                                    <!-- Hidden text area for old-compatibility compatibility -->
                                    <TextBox Name="RegexRulesBox" Visibility="Collapsed" Height="10"/>

                                    <!-- Interactive list of rules -->
                                    <ItemsControl Name="RegexRulesItemsControl" Margin="0,0,0,12">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#EBE9DF" BorderThickness="1" CornerRadius="6" Background="#FAF9F6" Padding="10,8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding IsActive}" Margin="0,0,10,0" Checked="RegexItem_StateChanged" Unchecked="RegexItem_StateChanged" VerticalAlignment="Center"/>
                                                        
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Pattern}" FontFamily="Consolas, Courier New" Foreground="#D06A4C" FontWeight="Bold" FontSize="11" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="9" Foreground="#7C7A74" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>

                                                        <Button Grid.Column="2" Click="DeleteRegexRule_Click" Background="Transparent" BorderThickness="0" Padding="4" VerticalAlignment="Center" Cursor="Hand">
                                                            <Path Width="12" Height="12" Fill="#A12626" Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Stretch="Uniform"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Sandbox Tester -->
                                    <Border BorderBrush="#EBE9DF" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="隔离规则动态捕获沙盒 (Dyn Sandbox)" FontWeight="SemiBold" FontSize="11" Foreground="#3D3D3A" Margin="0,0,0,8"/>
                                            
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="输入测试文本段:" VerticalAlignment="Center" FontSize="10"/>
                                                <TextBox Name="SandboxInputBox" TextChanged="SandboxInputBox_TextChanged" Grid.Column="1" Height="30" Tag="在此输入测试文本段，如：PLC_IO_01 或 &lt;Temp&gt;"/>
                                            </Grid>

                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="运行对位反馈效果:" VerticalAlignment="Center" FontSize="10"/>
                                                <TextBox Name="SandboxOutputBox" Grid.Column="1" Height="30" IsReadOnly="True" Background="#FAF9F6" Tag="此处将实时预览被隔离保护（不被翻译）后的文本效果"/>
                                                <TextBlock Name="SandboxCountLabel" Grid.Column="2" Text="0 处处理标记" FontSize="9" Foreground="#7C7A74" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Add Rule Inputs -->
                                            <Border Margin="0,10,0,0" Background="#FAF9F6" BorderBrush="#EBE9DF" BorderThickness="1" CornerRadius="6" Padding="10">
                                                <StackPanel>
                                                    <TextBlock Text="添加新隔离保护规则" FontWeight="SemiBold" FontSize="11" Foreground="#3D3D3A" Margin="0,0,0,8"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="3*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <StackPanel Margin="0,0,8,0">
                                                            <TextBlock Text="正则表达式 (Pattern)" FontSize="10" Foreground="#7C7A74" Margin="0,0,0,4"/>
                                                            <TextBox Name="NewRegexPatternBox" Height="28" Tag="如: [a-zA-Z]+ 或 PLC_.*"/>
                                                        </StackPanel>
                                                        
                                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                            <TextBlock Text="规则描述 (Description)" FontSize="10" Foreground="#7C7A74" Margin="0,0,0,4"/>
                                                            <TextBox Name="NewRegexDescBox" Height="28" Tag="如: 跳过全部英文字母且不翻译"/>
                                                        </StackPanel>
                                                        
                                                        <Button Name="AddRegexRuleBtn" Grid.Column="2" Content="＋ 添加规则" Height="28" Padding="12,2" VerticalAlignment="Bottom" Click="AddRegexRule_Click"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Hidden Right Column: Glossary Database to keep binding compatibility with C# behind -->
                            <Grid Visibility="Collapsed">
                                <TextBox Name="GlossaryFilterBox" TextChanged="GlossaryFilterBox_TextChanged"/>
                                <TextBlock Name="GlossaryCountLabel"/>
                                <ListBox Name="GlossaryDisplayListBox"/>
                                <TextBox Name="NewGlossarySourceBox"/>
                                <TextBox Name="NewGlossaryTargetBox"/>
                                <ComboBox Name="NewGlossaryCatComboBox"/>
                                <Button Name="AddGlossaryTermBtn" Click="AddGlossaryTerm_Click"/>
                                <ListBox Name="GlossaryListBox"/>
                                <Button Name="AddGlossaryBtn" Click="AddGlossary_Click"/>
                                <Button Name="RemoveGlossaryBtn" Click="RemoveGlossary_Click"/>
                            </Grid>
                            
                            <!-- Save Actions Footer -->
                            <Button Content="保存并应用配置" Click="SaveSettings_Click" Width="160" Height="32" Margin="0,8,0,16" Background="#494944" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ==================== TAB 2: 日志与导出汇总 ==================== -->
            <TabItem Header="导出与日志">
                <Grid>
                    <!-- Split columns -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="35*"/>
                            <ColumnDefinition Width="65*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Panel: Export -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,16,16" VerticalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Text="编目报告与翻译成果导出" FontWeight="Bold" FontSize="13" Foreground="#3D3D3A" Margin="0,0,0,12"/>

                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="生成文件保存路径 (可本地微调)" FontSize="11" Foreground="#7C7A74" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Name="ExportPathBox" Height="28" IsReadOnly="True" Background="#FAF9F6"/>
                                        <Button Name="BrowseExportPathBtn" Grid.Column="1" Content="浏览..." Click="BrowseExportPathBtn_Click" Margin="6,0,0,0" Height="28" Padding="12,2" Background="#FFFFFF" Foreground="#3D3D3A" BorderThickness="1" BorderBrush="#DDDBCF"/>
                                    </Grid>
                                </StackPanel>

                                <Button Name="DoExportBtn" Click="DoExportBtn_Click" Background="#232323" Foreground="#FFFFFF" Padding="16,8" FontWeight="Bold" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Path Width="12" Height="12" Fill="#FFFFFF" Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="开始一键编译并导出成果" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Right Panel: Syslog View -->
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16" VerticalAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Title / Description -->
                                    <RowDefinition Height="Auto"/> <!-- Filters bar -->
                                    <RowDefinition Height="*"/>    <!-- Logs list -->
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="EPLAN 智能内核系统运行日志 (Interactive Syslog)" FontWeight="Bold" FontSize="13" Foreground="#3D3D3A"/>
                                    <TextBlock Text="实时监控底层模型对齐、隔离表达式命中、服务商连接流" FontSize="10" Foreground="#7C7A74" Margin="0,2,0,10"/>
                                </StackPanel>

                                <!-- Filters bar -->
                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Filter buttons -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Name="LogFilterAllBtn" Content="全部日志" Click="LogFilterBtn_Click" Height="24" Padding="10,2" Margin="0,0,4,0"/>
                                        <Button Name="LogFilterInfoBtn" Content="info" Click="LogFilterBtn_Click" Height="24" Padding="10,2" Margin="0,0,4,0"/>
                                        <Button Name="LogFilterSuccessBtn" Content="success" Click="LogFilterBtn_Click" Height="24" Padding="10,2" Margin="0,0,4,0"/>
                                        <Button Name="LogFilterWarningBtn" Content="warning" Click="LogFilterBtn_Click" Height="24" Padding="10,2" Margin="0,0,4,0"/>
                                        <Button Name="LogFilterErrorBtn" Content="error" Click="LogFilterBtn_Click" Height="24" Padding="10,2" Margin="0,0,4,0"/>
                                    </StackPanel>

                                    <!-- Search input -->
                                    <TextBox Name="LogSearchTextBox" TextChanged="LogSearchTextBox_TextChanged" Grid.Column="1" Height="24" Tag="检索日志包含词条..."/>

                                    <!-- Clear button -->
                                    <Button Name="ClearLogBtn" Content="清空日志流" Click="ClearLogBtn_Click" Grid.Column="2" Height="24" Padding="10,2" Margin="6,0,0,0" Style="{StaticResource ResetButtonStyle}"/>
                                </Grid>

                                <!-- Scrollable Logs ListBox -->
                                <ListBox Name="LogListView" Grid.Row="2" BorderThickness="1" BorderBrush="#EBE9DF" Background="#FAF9F6">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="65"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Timestamp -->
                                                <TextBlock Text="{Binding Timestamp}" Foreground="#7C7A74" FontSize="11" VerticalAlignment="Center"/>
                                                <!-- Level Badge -->
                                                <Border Grid.Column="1" Background="{Binding TextBrush}" CornerRadius="4" Padding="4,1" Margin="6,0,8,0" HorizontalAlignment="Left" MinWidth="48">
                                                    <TextBlock Text="{Binding Level}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center"/>
                                                </Border>
                                                <!-- Message -->
                                                <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="#3D3D3A" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Progress and Actions Footer -->
        <Border Grid.Row="2" Background="#EFEFE9" BorderBrush="#EBE9DF" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Progress Bar Area -->
                <Grid Name="ProgressGrid" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <ProgressBar Name="TranslationProgressBar" Height="14" Minimum="0" Maximum="100" Value="0" Background="#E5E4DB" Foreground="#CD7F62" BorderThickness="0"/>
                        <TextBlock Name="ProgressTextBlock" Text="0%" Foreground="#FFFFFF" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#3D3D3A" BlurRadius="2" ShadowDepth="1" Opacity="0.8"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Grid>
                    <Button Name="CancelBtn" Grid.Column="1" Content="取消" Height="22" Padding="6,1" Background="#A12626" BorderThickness="0" Margin="10,0,0,0" FontSize="10" Click="CancelBtn_Click"/>
                </Grid>

                <TextBlock Name="ReadyLabel" Text="就绪" Foreground="Black" FontWeight="Bold" VerticalAlignment="Center" Visibility="Visible"/>
            </Grid>
        </Border>
    </Grid>
</Window>
